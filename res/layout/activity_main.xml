<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 标题栏：白色 + 返回箭头 + 居中标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="返回"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="嘉佰达BMS"
            android:textColor="#222222"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 实时页 -->
        <ScrollView
            android:id="@+id/page_dash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 蓝色 Hero 卡片 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_jbd_hero"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_conn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="未连接"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tv_update"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="8dp"
                            android:text=""
                            android:textColor="#E3F2FD"
                            android:textSize="10sp" />
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/btn_scan" android:layout_width="26dp" android:layout_height="26dp" android:background="@android:color/transparent" android:contentDescription="扫码连接" android:src="@drawable/ic_scan" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="扫码连接" android:textColor="#E3F2FD" android:textSize="9sp" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:gravity="center" android:orientation="vertical">
                            <ImageButton android:id="@+id/btn_connect" android:layout_width="26dp" android:layout_height="26dp" android:background="@android:color/transparent" android:contentDescription="蓝牙连接" android:src="@drawable/ic_bluetooth" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="蓝牙连接" android:textColor="#E3F2FD" android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.example.bmsdash.BatteryArcView
                            android:id="@+id/arc"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical">
                            <TextView android:id="@+id/tv_batt_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="限流模块：--" android:textColor="#FFFFFF" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_heat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="加热状态：--" android:textColor="#FFFFFF" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_balance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="均衡状态：--" android:textColor="#FFFFFF" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_jbd_hero_inner"
                        android:orientation="horizontal"
                        android:padding="10dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="充电开关：" android:textColor="#333333" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_charge_sw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_jbd_switch" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="18dp" android:background="@color/divider" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="放电开关：" android:textColor="#333333" android:textSize="13sp" />
                            <TextView android:id="@+id/tv_discharge_sw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_jbd_switch" android:paddingLeft="8dp" android:paddingRight="8dp" android:text="--" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 4x2 数据网格（带图标） -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:columnCount="4"
                    android:orientation="horizontal"
                    android:useDefaultMargins="false">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_voltage" />
                        <TextView android:id="@+id/tv_voltage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- V\n总电压" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_current" />
                        <TextView android:id="@+id/tv_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- A\n电流" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_power" />
                        <TextView android:id="@+id/tv_power" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- W\n功率" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_cycles" />
                        <TextView android:id="@+id/tv_cycles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="--\n循环次数" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_high" />
                        <TextView android:id="@+id/tv_cell_max" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- V\n最高电压" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_low" />
                        <TextView android:id="@+id/tv_cell_min" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- V\n最低电压" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_avg" />
                        <TextView android:id="@+id/tv_cell_avg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- V\n平均电压" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="3dp" android:background="@drawable/bg_jbd_data_cell" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_diff" />
                        <TextView android:id="@+id/tv_diff" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="-- V\n压差" android:textColor="@color/text_primary" android:textSize="13sp" />
                    </LinearLayout>
                </GridLayout>

                <!-- 电池状态 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:text="电池状态" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                    </LinearLayout>
                    <TextView android:id="@+id/tv_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="等待数据…" android:textColor="@color/jbd_blue" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- 温度行 -->
                <TextView
                    android:id="@+id/tv_temp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:text="单位：℃  MOS: --  T1: --  T2: --"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <!-- V12 扩展实时字段 -->
                <TextView
                    android:id="@+id/tv_v12_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:padding="12dp"
                    android:text="剩余容量 --  满充容量 --  湿度 --"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <!-- 单串电压信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:text="单串电压信息" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/divider" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_cell_extremes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="▲ 最高 --    ▼ 最低 --"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                    <GridLayout
                        android:id="@+id/grid_cells"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:columnCount="12"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- 近期趋势 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="近期趋势" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <com.example.bmsdash.ChartView
                        android:id="@+id/chart_live"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 参数页 -->
        <ScrollView
            android:id="@+id/page_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="报警阈值" android:textColor="@color/jbd_blue" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="center_vertical" android:text="压差过大 (mV)" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <EditText android:id="@+id/et_th_diff" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_edit" android:inputType="number" android:paddingLeft="8dp" android:text="20" android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="center_vertical" android:text="温度过高 (℃)" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <EditText android:id="@+id/et_th_temp" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_edit" android:inputType="numberDecimal" android:paddingLeft="8dp" android:text="45" android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="center_vertical" android:text="单体电压过低 (mV)" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <EditText android:id="@+id/et_th_cell" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_edit" android:inputType="number" android:paddingLeft="8dp" android:text="3000" android:textSize="14sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_gravity="center_vertical" android:text="低电量告警 (SOC%)" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <EditText android:id="@+id/et_th_soc" android:layout_width="80dp" android:layout_height="40dp" android:background="@drawable/bg_edit" android:inputType="number" android:paddingLeft="8dp" android:text="20" android:textSize="14sp" />
                    </LinearLayout>
                    <Button android:id="@+id/btn_save_th" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="12dp" android:background="@drawable/bg_button" android:text="保存阈值" android:textColor="#FFFFFF" android:textSize="14sp" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="蓝牙过滤与自动连接" android:textColor="@color/jbd_blue" android:textSize="15sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <CheckBox android:id="@+id/cb_filter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/filter_hint" android:textColor="@color/text_primary" android:textSize="13sp" android:checked="true" />
                    <TextView android:id="@+id/tv_saved_mac" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="已记住设备：无" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <Button android:id="@+id/btn_forget" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="8dp" android:background="@drawable/bg_button" android:text="清除已记住设备（关闭自动连接）" android:textColor="#FFFFFF" android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- 信息页：只保留真实可得的数据（本地历史 + 关于） -->
        <ScrollView
            android:id="@+id/page_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 电池基本信息 -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center" android:text="—  电池基本信息  —" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:text="设备名称" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_dev_name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:text="型号解析" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_model_parse" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:text="标称容量" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_capacity" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:text="电池生产商" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_maker" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:orientation="horizontal">
                        <TextView android:layout_width="78dp" android:layout_height="wrap_content" android:text="BMS型号" android:textColor="@color/text_secondary" android:textSize="12sp" />
                        <TextView android:id="@+id/tv_bms_model" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="--" android:textColor="@color/text_primary" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/tv_v12_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_jbd_data_cell"
                        android:lineSpacingExtra="3dp"
                        android:padding="10dp"
                        android:text="连接设备后自动读取"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/btn_history_entry" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="14dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_history" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_weight="1" android:text="本地历史记录" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/text_secondary" android:textSize="20sp" />
                </LinearLayout>

                <!-- 历史明细（点击历史记录展开） -->
                <LinearLayout android:id="@+id/history_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp" android:visibility="gone">
                    <TextView android:id="@+id/tv_hist_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="历史记录：0 条" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <com.example.bmsdash.ChartView
                        android:id="@+id/chart_history"
                        android:layout_width="match_parent"
                        android:layout_height="160dp" />
                    <TextView android:id="@+id/tv_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_primary" android:textSize="11sp" android:typeface="monospace" />
                    <Button android:id="@+id/btn_clear_hist" android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="6dp" android:background="@drawable/bg_button" android:text="清空历史" android:textColor="#FFFFFF" android:textSize="12sp" />
                </LinearLayout>

                <!-- 保护记录入口 -->
                <LinearLayout android:id="@+id/btn_protect_log_entry" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="14dp" android:paddingRight="14dp">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_history" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:layout_weight="1" android:text="保护记录" android:textColor="@color/text_primary" android:textSize="14sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/text_secondary" android:textSize="20sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/protect_log_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="10dp" android:visibility="gone">
                    <TextView android:id="@+id/tv_protect_log" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:text="暂无保护记录。当保护条件触发或解除时会自动记录。" android:textColor="@color/text_primary" android:textSize="11sp" android:typeface="monospace" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="—  保护参数与额定值  —" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:id="@+id/tv_v12_params" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="3dp" android:text="连接设备后自动读取" android:textColor="@color/text_primary" android:textSize="11sp" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="—  单体内阻 (0xF6)  —" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <GridLayout
                        android:id="@+id/grid_internal_res"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="关于" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="嘉佰达 BMS 助手（开源第三方工具）" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="协议：嘉佰达软件板通用协议 V4 / V12（只读）" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="开发者：ptlgf    版本：v1.0.0" android:textColor="@color/text_secondary" android:textSize="11sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="源码：github.com/ptlgf2024/bms-dashboard" android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 底部 Tab：实时 / 参数 / 信息（带图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/card"
        android:orientation="horizontal">

        <Button android:id="@+id/tab_dash" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:drawableTop="@drawable/ic_tab_realtime_on" android:drawablePadding="2dp" android:paddingTop="6dp" android:text="实时" android:textColor="@color/jbd_blue" android:textSize="12sp" />
        <Button android:id="@+id/tab_settings" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:drawableTop="@drawable/ic_tab_param" android:drawablePadding="2dp" android:paddingTop="6dp" android:text="参数" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <Button android:id="@+id/tab_history" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:drawableTop="@drawable/ic_tab_info" android:drawablePadding="2dp" android:paddingTop="6dp" android:text="信息" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
